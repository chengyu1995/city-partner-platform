# Supabase 基础配置（前端可安全访问，NEXT_PUBLIC_ 前缀是 Next.js 规范）
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 后端私有配置（仅服务端/API 路由可访问，前端无法读取，注意保密）
# 这两个变量是可选的——只有需要 service-role 权限时才必填
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Feishu callback authentication mode is explicit and fail-closed.
# Allowed: encrypted_signature | unencrypted_verification_token
FEISHU_CALLBACK_ENCRYPTION_MODE=unencrypted_verification_token
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
FEISHU_ENCRYPT_KEY=YOUR_FEISHU_ENCRYPT_KEY
FEISHU_VERIFICATION_TOKEN=YOUR_FEISHU_VERIFICATION_TOKEN
